# Paste these (with real values) into Streamlit Cloud -> App settings -> Secrets.
# Do NOT commit a real secrets.toml.

OPENROUTER_API_KEY = "sk-or-..."
LLM_MODEL = "your/openrouter-model-id"

# Run the A2A quiz service + CrewAI Study Buddy inside the app container
START_SIDECARS = "true"
USE_A2A_QUIZ = "true"
USE_STUDY_BUDDY = "true"

# Langfuse: leave LANGFUSE_* unset on the cloud, tracing is skipped automatically.
